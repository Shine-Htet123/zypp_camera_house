Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteRule "(^|/)\.(?!well-known/)" - [F,L]
RewriteRule "^database/.*\.(sql|sqlite)$" - [F,L,NC]
RewriteRule "^config/.*\.local(\.example)?\.php$" - [F,L,NC]
RewriteRule "^(composer\.(json|lock)|README\.md|DEPLOYMENT\.md)$" - [F,L,NC]
</IfModule>
